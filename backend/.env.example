# Server
PORT=5000

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Gemini AI API Key (Get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database - Options: sqlite | mysql
DB_DIALECT=sqlite

# MySQL Config (only needed if DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_resume_analyzer
DB_USER=root
DB_PASSWORD=your_password
